generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Representa a Clínica / Empresa
model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  
  // Dados da empresa para contratos
  razaoSocial     String?
  cnpj            String?
  endereco        String?

  users           User[]
  templates       ContractTemplate[]
  documents       GeneratedDocument[]

  moduleContracts Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Representa o Usuário que fará login
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          String    @default("USER")
  
  // Relacionamento com a Empresa (Tenant)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Modelos de Contrato
model ContractTemplate {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String   // Caminho para o .docx base
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Histórico de Documentos Gerados
model GeneratedDocument {
  id        String   @id @default(cuid())
  name      String
  type      String   // "CONTRATO" ou "BOLETIM"
  fileUrl   String   // Caminho para o PDF ou DOCX final gerado
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

// Representa os tokens de recuperação de senha e convite
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}
